<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etMaterialName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название армирующего материала"/>

    <EditText
        android:id="@+id/etMaterialDensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Плотность (г/м²)"
        android:inputType="numberDecimal"/>

    <EditText
        android:id="@+id/etMaterialCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Код материала (A, B, C...)"
        android:inputType="textCapCharacters"
        android:maxLength="3"/>

    <Button
        android:id="@+id/btnSaveMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Сохранить" />
</LinearLayout>